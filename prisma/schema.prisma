// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  firstName     String?
  lastName      String?
  password      String
  role          String    @default("viewer") // "admin", "editor", "viewer"
  clientId      String?   // Links user to their client organization
  firstLogin      Boolean   @default(true)
  lastActive      DateTime?
  digestEnabled         Boolean   @default(true)
  weeklyDigestEnabled   Boolean   @default(true)
  productUpdateEnabled  Boolean   @default(true)
  signupSource          String    @default("web") // "web" | "ios"; analytics attribution, not an authorization claim
  webOnboardingCompletedAt DateTime? // Null until an iOS-created account confirms its free web workspace
  mobileSubscriptionPlan String   @default("free") // "free" | "personal"
  mobileSubscriptionStatus String @default("inactive") // Apple lifecycle: inactive, active, grace_period, billing_retry, expired, revoked
  mobileSubscriptionExpiresAt DateTime?
  mobileSubscriptionUpdatedAt DateTime?
  appleOriginalTransactionId String? @unique
  appleProductId             String?
  appleSubscriptionEnvironment String? // "sandbox" | "production"
  blocked         Boolean   @default(false) // Admin-initiated lockout (suspected abuse/fraud). Checked at login and on every /api/auth/me poll.
  blockedAt       DateTime?
  blockedReason   String?
  createdAt             DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  client        Client?   @relation(fields: [clientId], references: [id])
  
  // Domain relationships
  domainAccess      UserDomainAccess[]
  submittedDomains  ClientDomain[]
  googleVerifiedDomains ClientDomain[] @relation("GoogleVerifiedByUser")
  ciViews       CiView[]
  entityTags    EntityTag[] // Added relation to entity tags created by this user
  lookupSearches LookupSearch[] // Searches made via the public lookup tool
  campaignAlerts CampaignAlertSubscription[]
  ciEntitySubscriptions CiEntitySubscription[]
  slackIntegrationsConnected SlackIntegration[] // Slack integrations this user (as Owner/Admin) completed setup for
  slackChannelsConnected     SlackChannel[] // Additional (paid, add-on) Slack bot channels this user completed setup for
  mobileRefreshTokens MobileRefreshToken[] // Mobile app refresh-token sessions (see lib/mobile-auth.ts)
  mobilePushTokens MobilePushToken[]
  mobileAlertDeliveries MobileAlertDelivery[]
  mobileSmsPushClaims MobileSmsPushClaim[]
  clientJoinInvitations ClientJoinInvitation[] @relation("ClientJoinInvitee")
  clientJoinInvitationsSent ClientJoinInvitation[] @relation("ClientJoinInviter")

  @@index([signupSource, webOnboardingCompletedAt])
  }

model Domain {
  id                String    @id @default(cuid())
  name              String    @unique // e.g., "Company ABC", "Acme Corp"
  domain            String    @unique // e.g., "company-abc.com", "acme.com"
  description       String?
  active            Boolean   @default(true)
  assignedToClientId String?  // Link to client who owns this domain
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relationships
  campaigns         Campaign[]
  userAccess        UserDomainAccess[]
  assignedToClient  Client?   @relation("DomainToClient", fields: [assignedToClientId], references: [id], onDelete: SetNull)

  @@index([assignedToClientId])
}

model UserDomainAccess {
  id       String @id @default(cuid())
  userId   String
  domainId String
  role     String @default("viewer") // "admin", "editor", "viewer" - role within this domain

  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, domainId])
}

model Campaign {
  id                 String        @id @default(cuid())
  subject            String
  sender             String